      "codeLine": 1,
      "note": "Initialize two pointers, i at start and j at end.",
      "array": [
        3,
        1,
        2,
        4
      ],
      "i": 0,
      "j": 3
    },
    {
      "codeLine": 2,
      "note": "Start loop: i < j (0 < 3) is true.",
      "array": [
        3,
        1,
        2,
        4
      ],
      "i": 0,
      "j": 3,
      "curr": 0
    },
    {
      "codeLine": 4,
      "note": "nums[i] is odd, nums[j] is even. Swap elements.",
      "array": [
        4,
        1,
        2,
        3
      ],
      "i": 0,
      "j": 3
    },
    {
      "codeLine": 2,
      "note": "Next iteration: i < j (0 < 3) is true.",
      "array": [
        4,
        1,
        2,
        3
      ],
      "i": 0,
      "j": 3,
      "curr": 0
    },
    {
      "codeLine": 3,
      "note": "nums[i] is even, increment i.",
      "array": [
        4,
        1,
        2,
        3
      ],
      "i": 1,
      "j": 3
    },
    {
      "codeLine": 4,
      "note": "nums[i] is odd, nums[j] is odd, decrement j.",
      "array": [
        4,
        1,
        2,
        3
      ],
      "i": 1,
      "j": 2
    },
    {
      "codeLine": 5,
      "note": "Swap nums[i] (1) and nums[j] (2).",
      "array": [
        4,
        2,
        1,
        3
      ],
      "i": 1,
      "j": 2,
      "curr": 1
    },
    {
      "codeLine": 2,
      "note": "Loop terminates as i is no longer less than j.",
      "array": [
        4,
        2,
        1,
