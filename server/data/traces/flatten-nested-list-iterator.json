  "description": "Flatten a nested list of integers using a stack-based iterator approach.",
  "pseudocode": "1: function flatten(nestedList) {\n2:   stack = [...nestedList].reverse();\n3: }\n4: function next() {\n5:   return stack.pop().getInteger();\n6: }\n7: function hasNext() {\n8:   while (stack.length > 0 && !stack[stack.length-1].isInteger()) {\n9:     curr = stack.pop().getList();\n10:    for (i = curr.length - 1; i >= 0; i--) stack.push(curr[i]);\n11:  }\n12:  return stack.length > 0;\n13: }",
