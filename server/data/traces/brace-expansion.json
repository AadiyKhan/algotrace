  "description": "Expand a string like '{a,b}c{d,e}f' into all possible combinations lexicographically.",
  "target": null,
  "pseudocode": "1. function expand(s) {\n2.   let groups = parse(s);\n3.   let res = [];\n4.   function backtrack(idx, path) {\n5.     if (idx === groups.length) return res.push(path.join(''));\n6.     for (let char of groups[idx]) {\n7.       backtrack(idx + 1, [...path, char]);\n8.     }\n9.   }\n10.  backtrack(0, []);\n11.  return res.sort();\n12. }",
