  "description": "Calculate the tilt of a binary tree, defined as the absolute difference between the sum of all left subtree node values and all right subtree node values.",
  "pseudocode": "let totalTilt = 0;\nfunction dfs(node) {\n  if (!node) return 0;\n  let leftSum = dfs(node.left);\n  let rightSum = dfs(node.right);\n  totalTilt += Math.abs(leftSum - rightSum);\n  return node.val + leftSum + rightSum;\n}\ndfs(root);",
