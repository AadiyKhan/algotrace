        -5,
        0,
        3,
        7
      ],
      "i": 0
    },
    {
      "codeLine": 3,
      "note": "Initialize right pointer to 4.",
      "array": [
        -10,
        -5,
        0,
        3,
        7
      ],
      "j": 4
    },
    {
      "codeLine": 5,
      "note": "Calculate mid index: (0+4)/2 = 2.",
