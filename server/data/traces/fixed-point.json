{
  "title": "Fixed Point",
  "difficulty": "Easy",
  "type": "array",
  "tags": [
    "Array",
    "Binary Search"
  ],
  "description": "Find the smallest index i such that arr[i] == i in a sorted array of distinct integers.",
  "target": "arr[i] == i",
  "pseudocode": "function findFixedPoint(arr) {\n  let left = 0;\n  let right = arr.length - 1;\n  let result = -1;\n  while (left <= right) {\n    let mid = Math.floor((left + right) / 2);\n    if (arr[mid] === mid) {\n      result = mid;\n      right = mid - 1;\n    } else if (arr[mid] < mid) {\n      left = mid + 1;\n    } else {\n      right = mid - 1;\n    }\n  }\n  return result;\n}",
  "steps": [
