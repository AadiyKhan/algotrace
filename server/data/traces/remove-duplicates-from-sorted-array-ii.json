  "pseudocode": "1. let i = 0\n2. for (let j = 0; j < nums.length; j++) {\n3.   if (i < 2 || nums[j] !== nums[i - 2]) {\n4.     nums[i] = nums[j]\n5.     i++\n6.   }\n7. }",
