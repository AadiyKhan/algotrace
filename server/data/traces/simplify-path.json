  "pseudocode": "1. components = path.split('/')\n2. stack = []\n3. for part in components:\n4.   if part == '..' and stack: stack.pop()\n5.   elif part != '.' and part != '' and part != '..': stack.push(part)\n6. return '/' + stack.join('/')",
