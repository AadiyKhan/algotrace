  "pseudocode": "1. arr.sort((a, b) => a - b);\n2. let removeCount = Math.floor(arr.length * 0.05);\n3. let sum = 0;\n4. for (let i = removeCount; i < arr.length - removeCount; i++) {\n5.   sum += arr[i];\n6. }\n7. return sum / (arr.length - 2 * removeCount);",
