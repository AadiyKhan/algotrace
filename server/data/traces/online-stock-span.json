{
  "title": "Online Stock Span",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "Array",
    "Stack",
    "Monotonic Stack"
  ],
  "description": "Calculate the span of a stock's price today, defined as the number of consecutive days (including today) before today where the price was less than or equal to today's price.",
  "target": null,
  "pseudocode": "1: span = 1\n2: while stack is not empty and stack.top.price <= price:\n3:   span += stack.pop().span\n4: stack.push({price, span})\n5: return span",
  "steps": [
    {
      "codeLine": 1,
      "note": "Initialize span for price 100",
      "array": [
        100
      ]
    },
    {
      "codeLine": 4,
      "note": "Stack empty, push {100, 1}",
      "array": [
        100
      ],
      "i": 1
    },
    {
      "codeLine": 1,
      "note": "Initialize span for price 80",
      "array": [
        100,
        80
      ]
    },
    {
      "codeLine": 2,
      "note": "80 <= 100 is false, skip while",
      "array": [
        100,
        80
      ]
    },
    {
      "codeLine": 4,
      "note": "Push {80, 1}",
      "array": [
        100,
        80
      ],
      "i": 1
    },
    {
      "codeLine": 1,
      "note": "Initialize span for price 85",
      "array": [
        100,
        80,
        85
      ]
    },
    {
      "codeLine": 2,
      "note": "85 >= 80, pop {80, 1}",
      "array": [
        100,
        80,
        85
      ]
    },
    {
      "codeLine": 3,
      "note": "span becomes 1 + 1 = 2",
      "array": [
        100,
        80,
        85
      ]
    },
    {
      "codeLine": 4,
      "note": "Push {85, 2}",
      "array": [
        100,
        80,
        85
      ],
      "i": 2
    }
  ]
}