  "description": "Find the subtree sum(s) that occur most frequently in the binary tree.",
  "pseudocode": "function getSum(node) {\n  if (!node) return 0;\n  let s = node.val + getSum(node.left) + getSum(node.right);\n  counts[s] = (counts[s] || 0) + 1;\n  maxFreq = Math.max(maxFreq, counts[s]);\n  return s;\n}",
