        3,
        4
      ],
      "curr": 4
    },
    {
      "codeLine": 4,
      "note": "Calculate next min(3*2, 2*3, 1*5) = 5",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 4,
      "curr": 3
    },
    {
      "codeLine": 5,
      "note": "Push 5 to array",
      "array": [
        1,
        2,
        3,
        4,
        5
      ],
      "curr": 5
    },
    {
      "codeLine": 8,
      "note": "5 is 1*5, increment p5",
      "array": [
        1,
        2,
        3,
        4,
        5
      ],
      "curr": 5
    }
  ]
}