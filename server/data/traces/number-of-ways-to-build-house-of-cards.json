  "description": "Calculate number of ways to build a house of cards with N total cards given specific height constraints.",
  "target": 16,
  "pseudocode": "function countWays(n) {\n  let dp = new Array(n + 1).fill(0);\n  dp[0] = 1;\n  for (let h = 1; ; h++) {\n    let cards = 3 * h * h + h / 2;\n    if (cards > n) break;\n    for (let j = n; j >= cards; j--) {\n      dp[j] += dp[j - cards];\n    }\n  }\n  return dp[n];\n}",
