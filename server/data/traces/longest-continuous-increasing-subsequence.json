{
  "title": "Longest Continuous Increasing Subsequence",
  "difficulty": "Easy",
  "type": "array",
  "tags": [
    "Array"
  ],
  "description": "Find the length of the longest continuous increasing subsequence in an array.",
  "target": 3,
  "pseudocode": "1. let maxLen = 0, anchor = 0\n2. for i from 0 to nums.length - 1:\n3.   if i > 0 and nums[i] <= nums[i-1]: anchor = i\n4.   maxLen = max(maxLen, i - anchor + 1)\n5. return maxLen",
  "steps": [
    {
      "codeLine": 1,
      "note": "Initialize maxLen and anchor to 0",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 2,
      "note": "Start iteration at i = 0",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 4,
      "note": "maxLen becomes 1",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 0,
      "curr": 1
    },
    {
      "codeLine": 2,
      "note": "Move to i = 1",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "maxLen becomes 2 (sequence: 1, 3)",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 1,
      "curr": 2
    },
    {
      "codeLine": 2,
      "note": "Move to i = 2",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 2,
      "curr": 2
    },
    {
      "codeLine": 4,
      "note": "maxLen becomes 3 (sequence: 1, 3, 5)",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 2,
      "curr": 3
    },
    {
      "codeLine": 2,
      "note": "Move to i = 3",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 3,
      "curr": 3
    },
    {
      "codeLine": 3,
      "note": "nums[3] (4) <= nums[2] (5), reset anchor to 3",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 3,
      "curr": 3
    },
    {
      "codeLine": 4,
      "note": "maxLen remains 3",
      "array": [
        1,
        3,
        5,
        4
      ],
      "i": 3,
      "curr": 3
    }
  ]
}