          0
        ],
        [
          0,
          0,
          1
        ]
      ],
      "visited": []
    },
    {
      "codeLine": 3,
      "note": "Starting loop at i=0.",
      "i": 0
    },
    {
      "codeLine": 4,
      "note": "Node 0 not visited, start DFS.",
      "i": 0
    },
    {
      "codeLine": 5,
      "note": "Increment count to 1.",
      "visited": [
        0
      ]
    },
    {
      "codeLine": 8,
      "note": "DFS marks node 0 as visited.",
      "visited": [
        0
      ]
    },
    {
      "codeLine": 10,
      "note": "Node 0 connected to 1, visiting 1.",
      "visited": [
        0,
        1
      ]
    },
    {
      "codeLine": 3,
      "note": "Back to main loop, i=1 is already visited, skip.",
      "i": 1,
      "visited": [
