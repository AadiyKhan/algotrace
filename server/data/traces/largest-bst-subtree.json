    "Dynamic Programming"
  ],
  "description": "Find the largest subtree which is a Binary Search Tree (BST) and return its size.",
  "pseudocode": "function solve(node) {\n  if (!node) return {size: 0, min: Infinity, max: -Infinity, isBST: true};\n  let left = solve(node.left);\n  let right = solve(node.right);\n  if (left.isBST && right.isBST && node.val > left.max && node.val < right.min) {\n    let size = left.size + right.size + 1;\n    return {size, min: Math.min(node.val, left.min), max: Math.max(node.val, right.max), isBST: true};\n  }\n  return {size: Math.max(left.size, right.size), min: 0, max: 0, isBST: false};\n}",
