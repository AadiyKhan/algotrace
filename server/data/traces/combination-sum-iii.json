  "description": "Find all valid combinations of k numbers that sum up to n such that only numbers from 1 to 9 are used.",
  "target": 7,
  "pseudocode": "function backtrack(start, k, target, currentPath) {\n  if (currentPath.length === k && target === 0) return result.push([...currentPath]);\n  for (let i = start; i <= 9; i++) {\n    if (i > target) break;\n    currentPath.push(i);\n    backtrack(i + 1, k, target - i, currentPath);\n    currentPath.pop();\n  }\n}",
