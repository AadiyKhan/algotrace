{
  "title": "Best Sightseeing Pair",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "Array",
    "Dynamic Programming"
  ],
  "description": "Find the maximum score of a sightseeing pair (values[i] + values[j] + i - j) where i < j.",
  "target": null,
  "pseudocode": "1: let maxScore = 0\n2: let maxI = values[0]\n3: for j from 1 to values.length - 1:\n4:   maxScore = max(maxScore, maxI + values[j] - j)\n5:   maxI = max(maxI, values[j] + j)",
  "steps": [
    {
      "codeLine": 1,
      "note": "Initialize maxScore to 0",
      "array": [
        8,
        1,
        5
      ],
      "i": null,
      "j": null,
      "curr": 0
    },
    {
      "codeLine": 2,
      "note": "Initialize maxI as values[0] + 0 = 8",
      "array": [
        8,
        1,
        5
      ],
      "curr": 0
    },
    {
      "codeLine": 3,
      "note": "Start loop at j=1",
      "array": [
        8,
        1,
        5
      ],
      "j": 1,
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "Calculate score: 8 + 1 - 1 = 8. maxScore becomes 8.",
      "array": [
        8,
        1,
        5
      ],
      "j": 1,
      "curr": 8
    },
    {
      "codeLine": 5,
      "note": "Update maxI: max(8, 1 + 1) = 8",
      "array": [
        8,
        1,
        5
      ],
      "j": 1,
      "curr": 8
    },
    {
      "codeLine": 3,
      "note": "Next loop at j=2",
      "array": [
        8,
        1,
        5
      ],
      "j": 2,
      "curr": 2
    },
    {
      "codeLine": 4,
      "note": "Calculate score: 8 + 5 - 2 = 11. maxScore becomes 11.",
      "array": [
        8,
        1,
        5
      ],
      "j": 2,
      "curr": 8
    },
    {
      "codeLine": 5,
      "note": "Update maxI: max(8, 5 + 2) = 8",
      "array": [
        8,
        1,
        5
      ],
      "j": 2,
      "curr": 8
    }
  ]
}