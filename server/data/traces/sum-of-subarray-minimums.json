      "note": "Initialize array [3, 1, 2]",
      "array": [
        3,
        1,
        2
      ],
      "curr": 3
    },
    {
      "codeLine": 8,
      "note": "Push index 0 (val 3) onto stack",
      "array": [
        3,
        1,
        2
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 5,
      "note": "Current val 1 is smaller than 3, trigger pop",
      "array": [
        3,
        1,
        2
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 6,
      "note": "Pop 0 (val 3), calc contribution: 3 * (1-0) * (0 - (-1)) = 3",
      "array": [
        3,
        1,
        2
      ],
      "i": 1,
      "curr": 0
    },
    {
      "codeLine": 8,
      "note": "Push index 1 (val 1) onto stack",
      "array": [
        3,
        1,
        2
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 5,
      "note": "Current val 2 is not smaller than 1, push index 2",
      "array": [
        3,
        1,
        2
      ],
      "i": 2,
      "curr": 2
