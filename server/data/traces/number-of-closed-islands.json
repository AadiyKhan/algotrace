  "description": "Find the number of closed islands (land cells fully surrounded by water) in a 2D grid.",
  "pseudocode": "function closedIsland(grid) {\n  let count = 0;\n  for(let r=0; r<rows; r++) for(let c=0; c<cols; c++) {\n    if(grid[r][c] === 0) {\n      if(isClosed(r, c)) count++;\n    }\n  }\n  return count;\n}",
