  "description": "Calculate the minimum time to collect all apples in a tree by returning to the root.",
  "pseudocode": "function dfs(node, parent, apples, time) {\n  let totalTime = 0;\n  for (let child of adj[node]) {\n    if (child !== parent) {\n      let childTime = dfs(child, node, apples, time + 2);\n      if (childTime > 0 || apples[child]) totalTime += childTime + 2;\n    }\n  }\n  return totalTime;\n}",
