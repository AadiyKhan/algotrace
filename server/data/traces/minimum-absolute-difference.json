{
  "title": "Minimum Absolute Difference",
  "difficulty": "Easy",
  "type": "array",
  "tags": [
    "Array",
    "Sorting"
  ],
  "description": "Find all pairs of elements with the minimum absolute difference in a sorted array.",
  "target": null,
  "pseudocode": "1. arr.sort((a, b) => a - b)\n2. minDiff = Infinity\n3. for i = 0 to arr.length - 2:\n4.   diff = arr[i+1] - arr[i]\n5.   if diff < minDiff: minDiff = diff, result = [[arr[i], arr[i+1]]]\n6.   else if diff == minDiff: result.push([arr[i], arr[i+1]])",
  "steps": [
    {
      "codeLine": 1,
      "note": "Sort the array: [4, 2, 1, 3] -> [1, 2, 3, 4]",
      "array": [
        1,
        2,
        3,
        4
      ],
      "curr": 4
    },
    {
      "codeLine": 3,
      "note": "Initialize minDiff and start loop at index 0",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 4,
      "note": "Calculate diff: 2 - 1 = 1",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 0,
      "curr": 2
    },
    {
      "codeLine": 5,
      "note": "minDiff is Infinity, update minDiff to 1 and result to [[1, 2]]",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 0,
      "curr": 1
    },
    {
      "codeLine": 3,
      "note": "Move to next iteration",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 1
    },
    {
      "codeLine": 4,
      "note": "Calculate diff: 3 - 2 = 1",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 1,
      "curr": 3
    },
    {
      "codeLine": 6,
      "note": "diff == minDiff (1 == 1), append [2, 3] to result",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 3,
      "note": "Move to last iteration",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 2
    },
    {
      "codeLine": 4,
      "note": "Calculate diff: 4 - 3 = 1",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 2,
      "curr": 4
    },
    {
      "codeLine": 6,
      "note": "diff == minDiff (1 == 1), append [3, 4] to result",
      "array": [
        1,
        2,
        3,
        4
      ],
      "i": 2,
      "curr": 1
    }
  ]
}