  "pseudocode": "1. let s = n.toString()\n2. let res = []\n3. let count = 0\n4. for (let i = s.length - 1; i >= 0; i--) {\n5.   if (count > 0 && count % 3 === 0) res.push('.')\n6.   res.push(s[i])\n7.   count++\n8. }\n9. return res.reverse().join('')",
