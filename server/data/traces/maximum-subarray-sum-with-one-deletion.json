        -2,
        3
      ],
      "i": null,
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "Processing index 1: end1 considers deleting -2 (previous end0=1)",
      "array": [
        1,
        -2,
        3
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 5,
      "note": "Processing index 1: end0 is max(-2, 1-2) = -1",
      "array": [
        1,
        -2,
        3
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 6,
      "note": "Update max result to 1",
      "array": [
        1,
        -2,
        3
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "Processing index 2: end1 is max(1+3, -1) = 4",
      "array": [
        1,
        -2,
        3
      ],
      "i": 2,
      "curr": 2
    },
    {
      "codeLine": 5,
      "note": "Processing index 2: end0 is max(3, -1+3) = 3",
      "array": [
        1,
        -2,
        3
      ],
      "i": 2,
      "curr": 2
    },
    {
      "codeLine": 6,
      "note": "Final update: max(1, 3, 4) = 4",
      "array": [
        1,
        -2,
        3
      ],
      "i": 2,
      "curr": 1
    }
  ]
