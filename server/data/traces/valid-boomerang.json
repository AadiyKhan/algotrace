  "description": "Determine if three points are not collinear to form a valid boomerang.",
  "pseudocode": "function isBoomerang(points) {\n  let [p1, p2, p3] = points;\n  // Check slope: (y2-y1)*(x3-x2) != (y3-y2)*(x2-x1)\n  return (p2[1] - p1[1]) * (p3[0] - p2[0]) !== (p3[1] - p2[1]) * (p2[0] - p1[0]);\n}",
  "steps": [
    {
      "codeLine": 2,
      "note": "Initialize points p1=[1,1], p2=[2,3], p3=[3,2]",
      "array": [
        [
          1,
          1
        ],
        [
          2,
          3
        ],
        [
          3,
          2
        ]
      ],
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "Calculate cross product to check if slopes are equal",
      "array": [
        [
          1,
          1
        ],
        [
          2,
          3
        ],
        [
          3,
          2
        ]
      ],
      "i": "(3-1)*(3-2) = 2*1 = 2",
      "j": "(2-3)*(2-1) = -1*1 = -1"
    },
    {
      "codeLine": 4,
      "note": "2 !== -1 is true, return true",
      "array": [
        [
          1,
          1
        ],
        [
          2,
          3
        ],
        [
          3,
          2
        ]
      ],
      "curr": 2
    }
  ]
