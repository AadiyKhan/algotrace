        3
      ],
      "curr": 2
    },
    {
      "codeLine": 4,
      "note": "Iterate i=0, adding contribution of 1 as min (p=1)",
      "array": [
        1,
        2,
        3
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 5,
      "note": "Sum = (0 + 1*1 - 3*1) = -2",
      "array": [
        1,
        2,
        3
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 6,
      "note": "Double power p=2",
      "array": [
        1,
        2,
        3
      ],
      "i": 0,
      "curr": 2
    },
    {
      "codeLine": 4,
      "note": "Iterate i=1, adding contribution of 2",
      "array": [
        1,
        2,
        3
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 5,
      "note": "Sum = (-2 + 2*2 - 2*2) = -2",
      "array": [
        1,
        2,
        3
      ],
      "i": 1,
      "curr": -2
    },
    {
      "codeLine": 6,
      "note": "Double power p=4",
      "array": [
        1,
        2,
        3
      ],
      "i": 1,
      "curr": 4
