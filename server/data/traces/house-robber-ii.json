  "description": "Rob houses in a circle where the first and last houses are connected. Cannot rob adjacent houses.",
  "pseudocode": "1. if (nums.length === 1) return nums[0];\n2. function robLinear(arr) {\n3.   let prev2 = 0, prev1 = 0;\n4.   for (let num of arr) {\n5.     let temp = Math.max(prev1, prev2 + num);\n6.     prev2 = prev1; prev1 = temp;\n7.   }\n8.   return prev1;\n9. }\n10. return Math.max(robLinear(nums.slice(0, -1)), robLinear(nums.slice(1)));",
