      "array": [
        "2"
      ]
    },
    {
      "codeLine": 5,
      "note": "Update n: 100 / 7 = 14",
      "i": 14
    },
    {
      "codeLine": 4,
      "note": "Calculate remainder: 14 % 7 = 0. Prepend to res.",
      "array": [
        "0",
        "2"
      ]
    },
    {
      "codeLine": 5,
      "note": "Update n: 14 / 7 = 2",
      "i": 2
    },
    {
      "codeLine": 4,
      "note": "Calculate remainder: 2 % 7 = 2. Prepend to res.",
      "array": [
        "2",
        "0",
        "2"
      ]
    },
    {
      "codeLine": 5,
      "note": "Update n: 2 / 7 = 0. Loop terminates.",
      "i": 0
    },
