  "pseudocode": "1. words = sentence.split(' ')\n2. vowels = 'aeiouAEIOU'\n3. for i, word in enumerate(words):\n4.   if word[0] in vowels:\n5.     word = word + 'ma'\n6.   else:\n7.     word = word[1:] + word[0] + 'ma'\n8.   word = word + ('a' * (i + 1))\n9.   words[i] = word\n10. return words.join(' ')",
