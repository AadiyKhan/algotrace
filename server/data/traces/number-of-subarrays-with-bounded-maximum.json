  "description": "Find the number of subarrays where the maximum element is between left and right.",
  "target": "left=2, right=3",
  "pseudocode": "function countSubarrays(nums, left, right) {\n  let res = 0, prevCount = 0, start = 0;\n  for (let end = 0; end < nums.length; end++) {\n    if (nums[end] > right) {\n      start = end + 1; prevCount = 0;\n    } else if (nums[end] >= left) {\n      prevCount = end - start + 1;\n      res += prevCount;\n    } else {\n      res += prevCount;\n    }\n  }\n  return res;\n}",
