      "codeLine": 1,
      "note": "Initialize boundaries for binary search.",
      "i": 1,
      "j": 8
    },
    {
      "codeLine": 3,
      "note": "Calculate mid point.",
      "i": 1,
      "j": 8,
      "curr": 4
    },
    {
      "codeLine": 4,
      "note": "4 * 4 = 16, which is > 8. Adjust right boundary.",
      "i": 1,
      "j": 3,
      "curr": 4
    },
    {
      "codeLine": 3,
      "note": "Calculate new mid point.",
      "i": 1,
      "j": 3,
      "curr": 2
    },
    {
      "codeLine": 5,
      "note": "2 * 2 = 4, which is < 8. Adjust left boundary.",
      "i": 3,
      "j": 3,
      "curr": 2
    },
    {
      "codeLine": 3,
      "note": "Calculate new mid point.",
      "i": 3,
      "j": 3,
      "curr": 3
    },
    {
      "codeLine": 4,
      "note": "3 * 3 = 9, which is > 8. Adjust right boundary.",
      "i": 3,
      "j": 2,
      "curr": 3
    },
    {
      "codeLine": 7,
      "note": "Loop ends, return right boundary (floor of sqrt).",
