  "description": "Find the median of the sliding window of size k moving from left to right.",
  "target": 3,
  "pseudocode": "1: let window = sorted array\n2: for i from 0 to n-1:\n3:   add nums[i] to window\n4:   if window.length > k: remove nums[i-k]\n5:   if window.length == k: record median",
  "steps": [
    {
      "codeLine": 2,
      "note": "Initialize window for nums = [1, 3, -1, -3], k = 3",
      "array": [
        1,
        3,
        -1,
        -3
      ],
      "i": 0,
      "curr": 1
    },
    {
      "codeLine": 3,
      "note": "Add nums[0]=1 to window",
      "array": [
        1
      ],
      "i": 0,
      "curr": 0
    },
    {
      "codeLine": 3,
      "note": "Add nums[1]=3 to window",
      "array": [
        1,
        3
      ],
      "i": 1,
      "curr": 1
    },
    {
      "codeLine": 3,
      "note": "Add nums[2]=-1 to window, sort window",
      "array": [
        -1,
        1,
        3
      ],
      "i": 2,
      "curr": 2
    },
    {
      "codeLine": 5,
      "note": "Window size is 3, median is index 1 (value 1)",
      "array": [
        -1,
        1,
        3
      ],
      "i": 2,
      "curr": 3
    },
    {
      "codeLine": 4,
      "note": "Slide window: remove nums[0]=1",
      "array": [
        -1,
        3
      ],
      "i": 3,
      "curr": 0
    },
    {
      "codeLine": 3,
      "note": "Add nums[3]=-3 to window, sort window",
      "array": [
        -3,
        -1,
        3
      ],
      "i": 3,
      "curr": 3
    },
    {
      "codeLine": 5,
      "note": "Window size is 3, median is index 1 (value -1)",
      "array": [
        -3,
        -1,
        3
      ],
      "i": 3,
      "curr": 3
    }
  ]
