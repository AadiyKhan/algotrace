  "description": "Given two non-negative integers num1 and num2 represented as string, return the sum of num1 and num2 as a string.",
  "pseudocode": "1. i = num1.length - 1, j = num2.length - 1, carry = 0\n2. res = []\n3. while i >= 0 or j >= 0 or carry:\n4.   sum = carry\n5.   if i >= 0: sum += num1[i--]\n6.   if j >= 0: sum += num2[j--]\n7.   res.push(sum % 10)\n8.   carry = Math.floor(sum / 10)\n9. return res.reverse().join('')",
  "steps": [
    {
      "codeLine": 1,
      "note": "Initialize pointers i, j to the ends of strings '9' and '1', carry is 0.",
      "array": [
        9,
        1
      ],
      "i": 0,
      "j": 0,
      "curr": 9
    },
    {
      "codeLine": 4,
      "note": "Calculate sum of digits: 9 + 1 + carry(0) = 10.",
      "array": [
        9,
        1
      ],
      "i": 0,
      "j": 0,
      "curr": 9
    },
    {
      "codeLine": 7,
      "note": "Push sum % 10 (0) to result array.",
      "array": [
        0
      ],
      "i": -1,
      "j": -1,
      "curr": 10
    },
    {
      "codeLine": 8,
      "note": "Update carry to 1 (10 / 10).",
      "array": [
        0
      ],
      "i": -1,
      "j": -1,
      "curr": 1
    },
    {
      "codeLine": 3,
      "note": "Loop continues because carry is 1.",
      "array": [
        0,
        1
      ],
      "i": -1,
      "j": -1,
      "curr": 1
    },
    {
      "codeLine": 7,
      "note": "Push carry 1 to result array.",
      "array": [
        0,
        1
      ],
      "i": -1,
      "j": -1,
      "curr": 1
    },
    {
      "codeLine": 9,
      "note": "Reverse and join result: '10'.",
      "array": [
        1,
        0
      ],
      "curr": 10
    }
  ]
}