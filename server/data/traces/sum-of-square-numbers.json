      "i": 0,
      "j": 2
    },
    {
      "codeLine": 4,
      "note": "Calculate sum = 0^2 + 2^2 = 4",
      "i": 0,
      "j": 2
    },
    {
      "codeLine": 6,
      "note": "4 < 5, increment left pointer",
      "i": 1,
      "j": 2
    },
    {
      "codeLine": 3,
      "note": "Check if left <= right (1 <= 2)",
      "i": 1,
      "j": 2
