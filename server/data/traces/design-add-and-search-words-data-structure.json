  "description": "Design a data structure that supports adding new words and searching for words which may contain dots '.' where a dot can match any letter.",
  "pseudocode": "function search(node, word, index) {\n  if (index === word.length) return node.isEnd;\n  char = word[index];\n  if (char === '.') {\n    for (let child of node.children) {\n      if (search(child, word, index + 1)) return true;\n    }\n  } else {\n    if (!node.children[char]) return false;\n    return search(node.children[char], word, index + 1);\n  }\n  return false;\n}",
