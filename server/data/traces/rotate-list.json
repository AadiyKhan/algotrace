      "note": "Break the circular link to finalize rotation.",
      "nodes": [
        {
          "val": 2,
          "next": 2
        },
        {
          "val": 3,
          "next": 0
        },
        {
          "val": 1,
          "next": null
        }
      ],
      "curr": 1
    }
  ]
