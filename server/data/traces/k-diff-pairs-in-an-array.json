      "note": "Initialize empty frequency map",
      "array": [
        1,
        2,
        3,
        1,
        2
      ]
    },
    {
      "codeLine": 2,
      "note": "Populate frequency map: {1: 2, 2: 2, 3: 1}",
      "array": [
        1,
        2,
        3,
        1,
        2
      ],
      "curr": 1
    },
    {
      "codeLine": 4,
      "note": "Checking key 1: map.has(1+2) is true, count becomes 1",
      "array": [
        1,
