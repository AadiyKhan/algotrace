{
  "title": "Remove Zero Sum Consecutive Nodes from Linked List",
  "difficulty": "Medium",
  "type": "linked-list",
  "tags": [
    "Linked List",
    "Hash Table"
  ],
  "description": "Remove sequences of consecutive nodes that sum to 0 repeatedly until no such sequences remain.",
  "pseudocode": "1. dummy = new Node(0, head)\n2. prefixSum = 0\n3. map = {0: dummy}\n4. curr = head\n5. while curr:\n6.   prefixSum += curr.val\n7.   if prefixSum in map:\n8.     toDelete = map[prefixSum].next\n9.     tempSum = prefixSum + toDelete.val\n10.    while toDelete != curr:\n11.      delete tempSum from map\n12.      toDelete = toDelete.next\n13.      tempSum += toDelete.val\n14.    map[prefixSum].next = curr.next\n15.  else:\n16.    map[prefixSum] = curr\n17.  curr = curr.next",
