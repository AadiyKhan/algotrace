  "description": "Serialize a binary search tree into a string and deserialize it back into the original BST structure using preorder traversal.",
  "pseudocode": "function serialize(root) {\n  let res = [];\n  function dfs(node) {\n    if (!node) res.push('#');\n    else {\n      res.push(node.val);\n      dfs(node.left);\n      dfs(node.right);\n    }\n  }\n  dfs(root);\n  return res.join(',');\n}",
