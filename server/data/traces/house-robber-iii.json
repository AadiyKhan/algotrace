  "description": "Find the maximum amount of money you can rob without robbing two directly connected houses in a binary tree.",
  "pseudocode": "function rob(node) {\n  if (!node) return [0, 0];\n  const left = rob(node.left);\n  const right = rob(node.right);\n  const robCurrent = node.val + left[1] + right[1];\n  const skipCurrent = Math.max(left[0], left[1]) + Math.max(right[0], right[1]);\n  return [robCurrent, skipCurrent];\n}",
