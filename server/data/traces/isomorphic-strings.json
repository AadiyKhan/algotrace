      "note": "Initialize loop with s = 'egg', t = 'add'",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 0
    },
    {
      "codeLine": 4,
      "note": "Mapping 'e' to 'a'. Both maps are empty.",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 0
    },
    {
      "codeLine": 5,
      "note": "Update maps: mapS['e']='a', mapT['a']='e'",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 0
    },
    {
      "codeLine": 2,
      "note": "Next iteration i = 1",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 1
    },
    {
      "codeLine": 4,
      "note": "Mapping 'g' to 'd'. Neither mapped yet.",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 1
    },
    {
      "codeLine": 5,
      "note": "Update maps: mapS['g']='d', mapT['d']='g'",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 1
    },
    {
      "codeLine": 2,
      "note": "Next iteration i = 2",
      "array": [
        "e",
        "g",
        "g"
      ],
      "i": 2
    },
    {
      "codeLine": 6,
      "note": "Check mapping for 'g'. It exists and maps to 'd'.",
      "array": [
        "e",
        "g",
