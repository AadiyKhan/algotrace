  "description": "Calculate x raised to the power n using the exponentiation by squaring method.",
  "target": null,
  "pseudocode": "1. function myPow(x, n) {\n2.   if (n === 0) return 1;\n3.   if (n < 0) return 1 / myPow(x, -n);\n4.   let half = myPow(x, Math.floor(n / 2));\n5.   if (n % 2 === 0) return half * half;\n6.   return x * half * half;\n7. }",
