  "description": "Construct a Quad-Tree representing a 2D binary grid.",
  "pseudocode": "function construct(grid, r, c, n) {\n  1: if (allSame(grid, r, c, n)) return new Node(grid[r][c] == 1, true);\n  2: node = new Node(true, false);\n  3: node.topLeft = construct(grid, r, c, n/2);\n  4: node.topRight = construct(grid, r, c + n/2, n/2);\n  5: node.bottomLeft = construct(grid, r + n/2, c, n/2);\n  6: node.bottomRight = construct(grid, r + n/2, c + n/2, n/2);\n  7: return node;\n}",
