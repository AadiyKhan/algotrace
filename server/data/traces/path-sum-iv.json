  "description": "Calculate the sum of all paths from the root to the leaves in a tree represented by a list of integers (depth, position, value).",
  "pseudocode": "function pathSum(nums) {\n  let map = new Map();\n  for (let n of nums) map.set(Math.floor(n / 10), n % 10);\n  let sum = 0;\n  function dfs(pos, currentSum) {\n    let depth = Math.floor(pos / 10), val = pos % 10;\n    let left = (depth + 1) * 10 + (2 * val - 1), right = (depth + 1) * 10 + (2 * val);\n    currentSum += map.get(pos);\n    if (!map.has(left) && !map.has(right)) sum += currentSum;\n    if (map.has(left)) dfs(left, currentSum);\n    if (map.has(right)) dfs(right, currentSum);\n  }\n  dfs(11, 0);\n  return sum;\n}",
