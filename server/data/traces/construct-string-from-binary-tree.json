  "description": "Construct a string consisting of parentheses and integers from a binary tree, omitting unnecessary empty parentheses.",
  "pseudocode": "function tree2str(root) {\n  if (!root) return \"\";\n  let s = root.val.toString();\n  if (root.left || root.right) {\n    s += \"(\" + tree2str(root.left) + \")\";\n  }\n  if (root.right) {\n    s += \"(\" + tree2str(root.right) + \")\";\n  }\n  return s;\n}",
