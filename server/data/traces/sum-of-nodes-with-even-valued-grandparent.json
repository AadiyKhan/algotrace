  "description": "Find the sum of values of nodes which have an even-valued grandparent.",
  "pseudocode": "function sumEvenGrandparent(root, p, gp) {\n  if (!root) return 0;\n  let sum = (gp % 2 === 0) ? root.val : 0;\n  return sum + sumEvenGrandparent(root.left, root.val, p) + sumEvenGrandparent(root.right, root.val, p);\n}",
