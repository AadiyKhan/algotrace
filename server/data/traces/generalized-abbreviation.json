  "pseudocode": "1: function backtrack(idx, current, count) {\n2:   if (idx === word.length) {\n3:     res.push(current + (count || ''));\n4:     return;\n5:   }\n6:   backtrack(idx + 1, current, count + 1); // Abbreviate\n7:   backtrack(idx + 1, current + (count || '') + word[idx], 0); // Keep\n8: }",
