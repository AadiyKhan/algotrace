{
  "title": "Zigzag Conversion",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "String"
  ],
  "description": "Convert a string s into a zigzag pattern on a given number of rows, then read line by line.",
  "target": 3,
  "pseudocode": "function convert(s, numRows):\n  if numRows == 1 or numRows >= len(s): return s\n  rows = [\"\" for _ in range(numRows)]\n  currRow, goingDown = 0, False\n  for char in s:\n    rows[currRow] += char\n    if currRow == 0 or currRow == numRows - 1:\n      goingDown = not goingDown\n    currRow += 1 if goingDown else -1\n  return \"\".join(rows)",
