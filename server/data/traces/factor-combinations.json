  "pseudocode": "1. function backtrack(n, start, path, result) {\n2.   for (let i = start; i * i <= n; i++) {\n3.     if (n % i === 0) {\n4.       path.push(i, n / i);\n5.       result.push([...path]);\n6.       path.pop();\n7.       backtrack(n / i, i, path, result);\n8.       path.pop();\n9.     }\n10.  }\n11. }",
