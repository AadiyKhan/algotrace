{
  "title": "K-th Symbol in Grammar",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "Recursion",
    "Math"
  ],
  "description": "Find the k-th symbol in the n-th row of a grammar where each row is generated by replacing 0 with 01 and 1 with 10.",
  "target": 1,
  "pseudocode": "1: function kthGrammar(n, k) {\n2:   if (n === 1) return 0;\n3:   let mid = Math.pow(2, n - 2);\n4:   if (k <= mid) return kthGrammar(n - 1, k);\n5:   return 1 - kthGrammar(n - 1, k - mid);\n6: }",
  "steps": [
    {
      "codeLine": 1,
      "note": "Starting recursion for n=3, k=2",
      "i": "n=3, k=2"
    },
    {
      "codeLine": 3,
      "note": "Calculate mid-point for row 3 (2^(3-2) = 2)",
      "i": "mid=2"
    },
    {
      "codeLine": 4,
      "note": "k (2) is <= mid (2), recurse to n=2, k=2",
      "i": "n=2, k=2"
    },
    {
      "codeLine": 3,
      "note": "Calculate mid-point for row 2 (2^(2-2) = 1)",
      "i": "mid=1"
    },
    {
      "codeLine": 5,
      "note": "k (2) > mid (1), recurse to 1 - kthGrammar(1, 1)",
      "i": "n=1, k=1"
    },
    {
      "codeLine": 2,
      "note": "Base case reached: n=1 returns 0",
      "i": "return 0"
    },
    {
      "codeLine": 5,
      "note": "Resolve parent call: 1 - 0 = 1",
      "i": "return 1"
    },
    {
      "codeLine": 4,
      "note": "Resolve top call: returns 1",
      "i": "result=1"
    }
  ]
}