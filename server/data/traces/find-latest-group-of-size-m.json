  "pseudocode": "1. length = new Array(n + 2).fill(0)\n2. count = new Array(n + 1).fill(0)\n3. lastStep = -1\n4. for step, pos in arr:\n5.   left = length[pos - 1], right = length[pos + 1]\n6.   newLen = left + right + 1\n7.   length[pos] = length[pos - left] = length[pos + right] = newLen\n8.   count[left]--, count[right]--\n9.   count[newLen]++\n10.  if count[m] > 0: lastStep = step",
