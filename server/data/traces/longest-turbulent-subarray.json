  "pseudocode": "1. let inc = 1, dec = 1, maxLen = 1\n2. for (let i = 1; i < arr.length; i++) {\n3.   if (arr[i] > arr[i-1]) { inc = dec + 1; dec = 1; }\n4.   else if (arr[i] < arr[i-1]) { dec = inc + 1; inc = 1; }\n5.   else { inc = 1; dec = 1; }\n6.   maxLen = Math.max(maxLen, inc, dec);\n7. }",
