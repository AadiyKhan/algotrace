{
  "title": "Beautiful Arrangement",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "Array",
    "Backtracking"
  ],
  "description": "Count how many permutations of numbers 1 to n satisfy the condition that for each position i, either number[i] % i == 0 or i % number[i] == 0.",
  "target": 2,
  "pseudocode": "function countArrangement(n) {\n  let count = 0;\n  let visited = new Array(n + 1).fill(false);\n  function backtrack(pos) {\n    if (pos > n) { count++; return; }\n    for (let i = 1; i <= n; i++) {\n      if (!visited[i] && (i % pos === 0 || pos % i === 0)) {\n        visited[i] = true;\n        backtrack(pos + 1);\n        visited[i] = false;\n      }\n    }\n  }\n  backtrack(1);\n  return count;\n}",
