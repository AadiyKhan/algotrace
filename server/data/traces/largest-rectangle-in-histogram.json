  "pseudocode": "1: stack = []\n2: maxArea = 0\n3: for i = 0 to heights.length:\n4:   while stack and heights[i] < heights[stack.top()]:\n5:     h = heights[stack.pop()]\n6:     w = stack.empty() ? i : i - stack.top() - 1\n7:     maxArea = max(maxArea, h * w)\n8:   stack.push(i)\n9: return maxArea",
