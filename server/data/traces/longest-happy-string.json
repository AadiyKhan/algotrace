    },
    {
      "codeLine": 4,
      "note": "Append two 'c's to avoid triple consecutive",
      "array": [
        "c",
        "c"
      ],
      "i": "c=5, b=1, a=1"
    },
    {
      "codeLine": 5,
      "note": "Append one 'b' because 'c' cannot be used",
      "array": [
        "c",
        "c",
        "b"
      ],
      "i": "c=5, b=0, a=1"
    },
    {
      "codeLine": 4,
      "note": "Append two 'c's",
      "array": [
        "c",
        "c",
        "b",
        "c",
        "c"
      ],
      "i": "c=3, b=0, a=1"
    },
    {
      "codeLine": 5,
      "note": "Append one 'a' because 'c' cannot be used",
      "array": [
        "c",
        "c",
        "b",
        "c",
        "c",
        "a"
      ],
      "i": "c=3, b=0, a=0"
    },
    {
      "codeLine": 4,
      "note": "Append two 'c's",
      "array": [
        "c",
        "c",
        "b",
        "c",
        "c",
        "a",
        "c",
        "c"
      ],
      "i": "c=1, b=0, a=0"
    },
    {
      "codeLine": 4,
      "note": "Append remaining 'c'",
      "array": [
        "c",
