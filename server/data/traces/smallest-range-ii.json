{
  "title": "Smallest Range II",
  "difficulty": "Medium",
  "type": "array",
  "tags": [
    "Array",
    "Math",
    "Greedy",
    "Sorting"
  ],
  "description": "Minimize the range (max - min) of an array after adding or subtracting k from each element.",
  "target": 2,
  "pseudocode": "1. nums.sort((a, b) => a - b)\n2. let n = nums.length\n3. let ans = nums[n-1] - nums[0]\n4. for (let i = 0; i < n - 1; i++) {\n5.   let high = Math.max(nums[n-1] - k, nums[i] + k)\n6.   let low = Math.min(nums[0] + k, nums[i+1] - k)\n7.   ans = Math.min(ans, high - low)\n8. }",
  "steps": [
    {
      "codeLine": 1,
      "note": "Sort array: [1, 3, 6], k=2",
      "array": [
        1,
        3,
        6
      ]
    },
    {
      "codeLine": 3,
      "note": "Initial range: 6 - 1 = 5",
      "array": [
        1,
        3,
        6
      ]
    },
    {
      "codeLine": 4,
      "note": "Check split point i=0",
      "i": 0,
      "array": [
        1,
        3,
        6
      ]
    },
    {
      "codeLine": 5,
      "note": "High = max(6-2, 1+2) = 4",
      "i": 0
    },
    {
      "codeLine": 6,
      "note": "Low = min(1+2, 3-2) = 1",
      "i": 0
    },
    {
      "codeLine": 7,
      "note": "ans = min(5, 4-1) = 3",
      "i": 0
    },
    {
      "codeLine": 4,
      "note": "Check split point i=1",
      "i": 1,
      "array": [
        1,
        3,
        6
      ]
    },
    {
      "codeLine": 5,
      "note": "High = max(6-2, 3+2) = 5",
      "i": 1
    },
    {
      "codeLine": 6,
      "note": "Low = min(1+2, 6-2) = 3",
      "i": 1
    },
    {
      "codeLine": 7,
      "note": "ans = min(3, 5-3) = 2",
      "i": 1
    }
  ]
