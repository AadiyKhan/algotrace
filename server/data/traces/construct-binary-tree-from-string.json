  "description": "Construct a binary tree from a string consisting of parenthesis and integers.",
  "target": "4(2(3)(1))(6(5))",
  "pseudocode": "function str2tree(s) {\n  if (!s) return null;\n  let stack = [];\n  for (let i = 0; i < s.length; i++) {\n    if (s[i] === ')') stack.pop();\n    else if (s[i] === '(') continue;\n    else {\n      let j = i;\n      while (i + 1 < s.length && !isNaN(s[i + 1]) && s[i+1] !== '(' && s[i+1] !== ')') i++;\n      let node = {val: parseInt(s.substring(j, i + 1)), left: null, right: null};\n      if (stack.length > 0) {\n        let parent = stack[stack.length - 1];\n        if (!parent.left) parent.left = node;\n        else parent.right = node;\n      }\n      stack.push(node);\n    }\n  }\n  return stack[0];\n}",
